s112 = [('P1',0,5), ('P2',1,3), ('P3',2,6)]
aditya = 2
t, rem, ct, Q, i = 0, {x[0]:x[2] for x in s112}, {}, [], 0
print("S112 aDITYA sINGH")

while len(ct) < 3:
    while i < 3 and s112[i][1] <= t:
        Q.append(s112[i][0]); i += 1
    if not Q:
        t = s112[i][1]; continue
    x = Q.pop(0)
    r = min(aditya, rem[x])
    t += r; rem[x] -= r
    while i < 3 and s112[i][1] <= t:
        Q.append(s112[i][0]); i += 1
    if rem[x]: Q.append(x)
    else: ct[x] = t

tat = {x:ct[x]-a for x,a,b in s112}
wt = {x:tat[x]-b for x,a,b in s112}

print("Avg Turnaround Time =", sum(tat.values())/3, "ms")
print("Avg Waiting Time  =", sum(wt.values())/3, "ms")
