    exit()

# FIFO
fifo_hits, fifo_misses, fifo_hit_ratio, fifo_miss_ratio = \
    fifo_page_replacement(pages, frames)

# LRU
lru_hits, lru_misses, lru_hit_ratio, lru_miss_ratio = \
    lru_page_replacement(pages, frames)



