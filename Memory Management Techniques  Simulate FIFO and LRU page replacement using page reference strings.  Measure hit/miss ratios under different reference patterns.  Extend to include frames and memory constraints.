def fifo_page_replacement(pages, frames):
    memory = []
    hits = 0
    misses = 0
    pointer = 0

    print("\n--- FIFO Page Replacement ---")
    print("Page\tMemory\t\tResult")

    for page in pages:
        if page in memory:
            hits += 1
            result = "Hit"
        else:
            misses += 1
            result = "Miss"

            if len(memory) < frames:
                memory.append(page)
            else:
                memory[pointer] = page
                pointer = (pointer + 1) % frames

        print(f"{page}\t{memory}\t\t{result}")

    hit_ratio = hits / len(pages)
    miss_ratio = misses / len(pages)

    return hits, misses, hit_ratio, miss_ratio


def lru_page_replacement(pages, frames):
    memory = []
    hits = 0
    misses = 0

    print("\n--- LRU Page Replacement ---")
    print("Page\tMemory\t\tResult")

    for page in pages:
        if page in memory:
            hits += 1
            result = "Hit"

            memory.remove(page)
            memory.append(page)

        else:
            misses += 1
            result = "Miss"

            if len(memory) < frames:
                memory.append(page)
            else:
                memory.pop(0)
                memory.append(page)

        print(f"{page}\t{memory}\t\t{result}")

    hit_ratio = hits / len(pages)
    miss_ratio = misses / len(pages)

    return hits, misses, hit_ratio, miss_ratio


